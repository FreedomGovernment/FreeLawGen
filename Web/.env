# FreeLawGen Environment — local/dev defaults
# Real/production secrets go in .env.local (gitignored). This file holds
# non-secret, non-local defaults that are safe to commit.

# Postgres for Drizzle (local dev DB). Override in .env.local for prod.
DATABASE_URL=postgresql://localhost:5432/postgres

# NextAuth URL — local dev. Override in .env.local to https://freelawgen.org for prod.
NEXTAUTH_URL=http://localhost:3000

# Development-only NextAuth secret. Set a real secret in .env.local for production.
NEXTAUTH_SECRET=dev-se...tion
